# Aggregator Web 平台环境变量样例（复制为 .env 或直接设置环境变量）
# 注意：真实凭证勿提交；.env 已被 .gitignore 排除

# 数据根目录（SQLite 数据库、本地产物、密钥）
AGG_DATA_DIR=./data

# 数据库连接（默认 sqlite）
# AGG_DATABASE_URL=sqlite:///./data/aggregator.db

# JWT 签名密钥（留空则首次启动自动生成并写入 data/.secret.key）
# AGG_JWT_SECRET=

# 初始管理员（首次启动后请修改密码）
AGG_ADMIN_USER=admin
AGG_ADMIN_PASSWORD=admin123

# 监听地址
AGG_HOST=127.0.0.1
AGG_PORT=8080

# 引擎选择：留空=真实引擎（复用 subscribe/，需网络与 mihomo/subconverter 二进制）
# hermetic=确定性测试引擎（E2E/演示用，无网络依赖）
# AGG_ENGINE=
